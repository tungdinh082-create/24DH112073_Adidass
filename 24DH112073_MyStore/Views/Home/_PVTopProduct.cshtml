@model _24DH112073_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc;
@using PagedList;

@* Bạn có thể cần tạo file CSS này sau, hoặc xóa dòng link đi *@
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
        <ul class="list-container">

            @foreach (var product in Model.TopProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage ?? "~/Content/images/default.png")" />
                        </a>
                    </div>
                    <div>
                        <p class="prodName" style="height: 40px; overflow: hidden;">@Html.DisplayFor(modelItem => product.ProductName)</p>
                        <p class="prodPrice">@Html.FormatValue(product.ProductPrice, "{0:N0} VNĐ")</p>
                    </div>
                </li>
            }

        </ul>
    </section>

    <div class="pagination-container" style="text-align: center;">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetail",
            new
                 {
                page,
                id = Model.Product.ProductID,
                quantity = Model.quantity
            }),
            new PagedListRenderOptions
            {
                UlElementClasses = new List<string> { "pagination" },
                LiElementClasses = new List<string> { "page-item" }
            })
    </div>
}
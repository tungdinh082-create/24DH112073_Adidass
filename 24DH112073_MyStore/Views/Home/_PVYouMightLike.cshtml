@* LƯU Ý: Model ở đây là một Danh sách sản phẩm (List<Product>)
    Chứ không phải là HomeProductVM.
    Khi gọi PartialView này, bạn phải truyền Model.YouMightLikeProducts vào.
*@
@model IEnumerable<_24DH112073_MyStore.Models.Product>

<div class="row" style="margin-top: 30px; margin-bottom: 20px;">
    <div class="col-md-12 text-center">
        <h2 style="color: #c00; font-weight: bold; text-transform: uppercase;">
            Cháy Hàng Cuối Ngày
        </h2>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6" style="margin-bottom: 20px;">

                <div class="product-card" style="border: 1px solid #ccc; border-radius: 10px; padding: 10px; height: 100%; background-color: #fff;">

                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.png")"
                             alt="@item.ProductName"
                             style="width: 100%; height: 180px; object-fit: contain; margin-bottom: 10px;" />
                    </a>

                    <p style="color: blue; font-weight: bold; font-size: 16px; margin-bottom: 5px;">
                        @Html.FormatValue(item.ProductPrice, "{0:N0} VNĐ")
                    </p>

                    <h5 style="font-weight: bold; height: 40px; overflow: hidden; font-size: 14px;">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                           style="color: #333; text-decoration: none;">
                            @item.ProductName
                        </a>
                    </h5>

                    <p style="color: #777; font-size: 12px; margin-top: 5px;">
                        Đã bán: @(item.OrderDetails != null ? item.OrderDetails.Count : 0)
                    </p>

                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-12 text-center">
            <p>Đang cập nhật sản phẩm gợi ý...</p>
        </div>
    }
</div>

@model _24DH112073_MyStore.Models.ViewModel.ChangePasswordVM

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; 
}

<h2 class="bg-success" style="padding: 10px; color: white;">ĐỔI MẬT KHẨU</h2>
<hr />

<div class="row">
    <div class="col-md-3">
        <div class="list-group">
            <a href="@Url.Action("ProfileInfo", "Account")" class="list-group-item list-group-item-action">
                Thông tin tài khoản
            </a>
            <a href="@Url.Action("MyOrder", "Order")" class="list-group-item list-group-item-action">
                Quản lý đơn hàng
            </a>
            <a href="@Url.Action("Logout", "Account")" class="list-group-item list-group-item-action">
                Đăng xuất
            </a>
        </div>
    </div>

    <div class="col-md-9">
        <h4>Thay đổi mật khẩu của bạn</h4>
        <hr />

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @* Hiển thị lỗi chung *@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(model => model.OldPassword, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @* Thêm maxlength = 20 vào đây *@
                        @Html.EditorFor(model => model.OldPassword, new { htmlAttributes = new { @class = "form-control", @type = "password", maxlength = 20 } })
                        @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.NewPassword, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @* Thêm maxlength = 20 vào đây *@
                        @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @class = "form-control", @type = "password", maxlength = 20 } })
                        @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ConfirmNewPassword, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @* Thêm maxlength = 20 vào đây *@
                        @Html.EditorFor(model => model.ConfirmNewPassword, new { htmlAttributes = new { @class = "form-control", @type = "password", maxlength = 20 } })
                        @Html.ValidationMessageFor(model => model.ConfirmNewPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group mt-3" style="margin-top: 15px;">
                    <div class="col-md-offset-4 col-md-8">
                        <input type="submit" value="Đổi mật khẩu" class="btn btn-primary" />
                        @Html.ActionLink("Hủy", "ProfileInfo", null, new { @class = "btn btn-danger" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
@model _24DH112073_MyStore.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="jumbotron text-center">
    <h1 class="display-3" style="color: green;">Đặt hàng Thành công!</h1>
    <p class="lead">Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là: <strong>@Model.OrderID</strong></p>
    <hr>
</div>

<h3>Thông tin đơn hàng</h3>
<dl class="dl-horizontal">
    <dt>Ngày đặt hàng:</dt>
    <dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd>

    <dt>Tổng số tiền:</dt>
    <dd>@Html.FormatValue(Model.TotalAmount, "{0:N0} VNĐ")</dd>

    <dt>Trạng thái thanh toán:</dt>
    <dd>@Model.PaymentStatus</dd>

    <dt>Phương thức thanh toán:</dt>
    <dd>@Model.PaymentMethod</dd>

    <dt>Phương thức giao hàng:</dt>
    <dd>@Model.DeliveryMethod</dd> @* <-- SỬA 1: Đổi "ShippingMethod" thành "DeliveryMethod" *@

    <dt>Địa chỉ giao hàng:</dt>
    <dd>@Model.AddressDelivery</dd> @* <-- SỬA 2: Đổi "ShippingAddress" thành "AddressDelivery" *@
</dl>

<h3>Chi tiết đơn hàng</h3>
<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Tổng giá</th>
        </tr>
    </thead>
    <tbody>
        @* Lặp qua các chi tiết đơn hàng (đã được Include trong Controller) *@
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                @* SỬA 3: Thêm kiểm tra "Product" null (nếu có) *@
                <td>@(item.Product != null ? item.Product.ProductName : "Sản phẩm đã bị xóa")</td>
                <td>@item.Quantity</td>
                <td>@Html.FormatValue(item.UnitPrice, "{0:N0} VNĐ")</td>
                <td>@Html.FormatValue(item.TotalPrice, "{0:N0} VNĐ")</td>
            </tr>
        }
    </tbody>
</table>

<p class="lead" style="margin-top: 20px;">
    @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-primary" })
    @* SỬA 4: Sửa link "Lịch sử mua hàng" trỏ đến Action mới "MyOrder" *@
    @Html.ActionLink("Xem Lịch sử mua hàng", "MyOrder", "Order", null, new { @class = "btn btn-primary" })
</p>
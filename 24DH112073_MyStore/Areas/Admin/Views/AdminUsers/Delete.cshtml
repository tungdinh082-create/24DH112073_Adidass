@model _24DH112073_MyStore.Models.User

@{
    ViewBag.Title = "Xác nhận Xóa Tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Sử dụng Layout Admin
}

<h2 class="bg-danger" style="padding:10px; color:white;">XÁC NHẬN XÓA TÀI KHOẢN</h2>

<h3 class="text-danger">Bạn có chắc muốn xóa tài khoản "@Model.Username" không?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Tên đăng nhập
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Username)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Password)
        </dt>
        <dd>
            ******
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.UserRole)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.UserRole)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> 
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary " })
        </div>
    }
</div>
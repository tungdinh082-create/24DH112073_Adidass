@model _24DH112073_MyStore.Models.User

@{
    ViewBag.Title = "Chi tiết Tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Dùng Layout Admin
}

<h2 class="bg-success" style="padding:10px;">CHI TIẾT TÀI KHOẢN</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        @* SỬA 1: Thêm trường Username *@
        <dt>
            Tên đăng nhập
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Username)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Password)
        </dt>
        <dd>
            ******
            @* Không nên hiển thị mật khẩu ra ngoài *@
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.UserRole)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.UserRole)
        </dd>
    </dl>
</div>
<p>
    @* SỬA 2: Truyền đúng khóa chính (id = Model.Username) và thêm class cho nút *@
    @Html.ActionLink("Sửa", "Edit", new { id = Model.Username }, new { @class = "btn btn-primary" }) 
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" }, new { @class = "btn btn-primary" })
</p>

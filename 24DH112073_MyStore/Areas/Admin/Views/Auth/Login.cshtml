
@{
    Layout = null;
    ViewBag.Title = "Đăng nhập Admin";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        .login-container {
            max-width: 500px;
            margin: 100px auto;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-container">
            <h2 class="text-center">Đăng nhập Trang Quản Trị</h2>
            <hr />

            @using (Html.BeginForm("Login", "Auth", new { Area = "Admin" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="username" class="control-label">Tên đăng nhập</label>
                    <input type="text" name="username" id="username" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="password" class="control-label">Mật khẩu</label>
                    <input type="password" name="password" id="password" class="form-control" required />
                </div>

                @* Hiển thị lỗi nếu đăng nhập sai *@
                if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" style="margin-top: 15px;">@ViewBag.Error</div>
                }

                <div class="form-group" style="margin-top: 20px;">
                    <input type="submit" value="Đăng nhập" class="btn btn-primary btn-block" />
                </div>
            }
        </div>
    </div>
</body>
</html>

@model IEnumerable<_24DH112073_MyStore.Models.Product>

@{
    ViewBag.Title = "Thùng rác";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-danger">Sản phẩm đã Ẩn</h2>

<p>
    @Html.ActionLink("Quay lại danh sách sản phẩm", "Index", null, new { @class = "btn btn-info" })
</p>

<table class="table table-bordered table-hover">
    <tr>
        <th>Tên sản phẩm</th>
        <th>Giá</th>
        <th>Hình ảnh</th>
        <th>Trạng thái</th>
        <th>Hành động</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.FormatValue(item.ProductPrice, "{0:N0} đ")
            </td>
            <td>
                <img src="@item.ProductImage" width="60" height="60" style="object-fit: cover;" />
            </td>
            <td>
                <span class="label label-danger">Đã Ẩn</span>
            </td>
            <td>
                <a href="@Url.Action("Undo", new { id = item.ProductID })"
                   class="btn btn-success btn-sm"
                   onclick="return confirm('Bạn có chắc muốn khôi phục sản phẩm này không?');">
                    <i class="glyphicon glyphicon-refresh"></i> Khôi phục
                </a>

                <a href="@Url.Action("HardDelete", new { id = item.ProductID })"
                   class="btn btn-danger btn-sm"
                   style="margin-left: 5px;">
                    <i class="glyphicon glyphicon-remove"></i> Xóa Vĩnh viễn
                </a>
            </td>
        </tr>
    }

</table>
@model _24DH112073_MyStore.Models.Customer

@{
    ViewBag.Title = "Sửa thông tin Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Sử dụng Layout Admin
}

<h2 class="bg-success" style="padding:10px;">SỬA KHÁCH HÀNG: @Model.CustomerName</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        @* RẤT QUAN TRỌNG: Thêm dòng này để form biết đang sửa Khách hàng nào *@
        @Html.HiddenFor(model => model.CustomerID)

        @* Gọi Partial View chứa code form (Tên, SĐT, Email...) *@
        @Html.Partial("PVCreateEditCustomer", Model)

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" }, new { @class = "btn btn-primary btn-sm" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
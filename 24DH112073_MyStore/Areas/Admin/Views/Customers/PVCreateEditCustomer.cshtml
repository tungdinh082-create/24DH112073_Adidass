        @* Dùng DropDownList để chọn từ Bảng User *@
        @Html.DropDownList("Username", null, "--- Chọn tài khoản ---", htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
    </div>

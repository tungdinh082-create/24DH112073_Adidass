@model _24DH112073_MyStore.Models.Customer

@{
    ViewBag.Title = "Xác nhận Xóa Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; 
}

<h2 class="bg-danger" style="padding:10px; color:white;">XÁC NHẬN XÓA KHÁCH HÀNG</h2>

<h3 class="text-danger">Bạn có chắc muốn xóa khách hàng này?</h3>

@*CODE NÀY ĐỂ HIỂN THỊ LỖI *@
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Tên Khách hàng
        </dt>
        <dd>
            @Html.DisplayFor(model => model.CustomerName)
        </dd>

        <dt>
            Số điện thoại
        </dt>
        <dd>
            @Html.DisplayFor(model => model.CustomerPhone)
        </dd>

        <dt>
            Email
        </dt>
        <dd>
            @Html.DisplayFor(model => model.CustomerEmail)
        </dd>

        <dt>
            Địa chỉ
        </dt>
        <dd>
            @Html.DisplayFor(model => model.CustomerAddress)
        </dd>

        <dt>
            Tài khoản (Username)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.User.Username)
        </dd>
    </dl>

    @* Form để thực hiện hành động Xóa (POST) *@
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" }, new { @class = "btn btn-primary " })
        </div>
    }
</div>